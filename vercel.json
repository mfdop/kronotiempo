{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!sw\.js|manifest\.json|icon-.*\.png|favicon\.svg|assets/).*)", "destination": "/index.html" }
  ]
}
